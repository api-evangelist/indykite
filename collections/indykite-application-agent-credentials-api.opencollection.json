{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Application Agent Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Application Agent Credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/application-agent-credentials",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Project ID where to search for Application Agent credentials."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "List only objects, that contains given search query in name, display name or description"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Application Agent Credentials in provided Project with optional filtering."
        },
        {
          "info": {
            "name": "Register Application Agent credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/application-agent-credentials",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Register Application Agent credentials in provided Application Agent."
        },
        {
          "info": {
            "name": "Read Application Agent Credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/application-agent-credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application Agent Credential ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read Application Agent Credential identified by provided ID."
        },
        {
          "info": {
            "name": "Delete Application Agent Credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/application-agent-credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application Agent ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Application Agent Credential by provided ID."
        }
      ]
    }
  ],
  "bundled": true
}