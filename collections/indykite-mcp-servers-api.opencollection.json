{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials MCP Servers API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "MCP Servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List MCP Servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/mcp-servers",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Project ID in GID format"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all MCP Server configurations in a project"
        },
        {
          "info": {
            "name": "Create MCP Server",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/mcp-servers",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new MCP Server configuration"
        },
        {
          "info": {
            "name": "Read MCP Server",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/mcp-servers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "MCP Server ID in GID format or name"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Project ID in GID format (required when using name)"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version number to read"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read an MCP Server configuration by ID or name"
        },
        {
          "info": {
            "name": "Update MCP Server",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://eu.api.indykite.com/configs/v1/mcp-servers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "MCP Server ID in GID format"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing MCP Server configuration"
        },
        {
          "info": {
            "name": "Delete MCP Server",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/mcp-servers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "MCP Server ID in GID format"
              },
              {
                "name": "etag",
                "value": "",
                "type": "query",
                "description": "ETag for optimistic concurrency control"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an MCP Server configuration"
        }
      ]
    }
  ],
  "bundled": true
}