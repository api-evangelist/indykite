{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials Service Accounts API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Service Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Service Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/service-accounts",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Organization ID where to search for Service Accounts."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "List only objects, that contains given search query in name, display name or description"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Service Accounts in provided Organization with optional filtering."
        },
        {
          "info": {
            "name": "Create Service Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/service-accounts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Service Account in provided Organization."
        },
        {
          "info": {
            "name": "Read Service Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/service-accounts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Service Account ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version of configuration to read. If not provided, latest version is returned."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read Service Account identified by provided ID."
        },
        {
          "info": {
            "name": "Update Service Account",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://eu.api.indykite.com/configs/v1/service-accounts/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Service Account ID or name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update Service Account identified by provided ID and optionally etag in If-Match header."
        },
        {
          "info": {
            "name": "Delete Service Account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/service-accounts/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Service Account ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Service Account by provided ID. You can optionally can specify etag in If-Match header."
        }
      ]
    }
  ],
  "bundled": true
}