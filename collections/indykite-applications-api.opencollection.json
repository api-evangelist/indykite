{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials Applications API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/applications",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Project ID where to search for Applications."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "List only objects, that contains given search query in name, display name or description"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Applications in provided Project with optional filtering."
        },
        {
          "info": {
            "name": "Create Application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/applications",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Application in provided Project."
        },
        {
          "info": {
            "name": "Read Application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID or name"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version of configuration to read. If not provided, latest version is returned."
              },
              {
                "name": "location",
                "value": "",
                "type": "query",
                "description": "Parent project ID. Required when querying by name"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read Application, formerly known as Application space, identified by provided ID."
        },
        {
          "info": {
            "name": "Update Application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://eu.api.indykite.com/configs/v1/applications/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update Application, formerly known as Application space, identified by provided ID and optionally etag in If-Match header."
        },
        {
          "info": {
            "name": "Delete Application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/applications/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Application ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Application, formerly known as Application space, by provided ID. You can optionally can specify etag in If-Match header."
        }
      ]
    }
  ],
  "bundled": true
}