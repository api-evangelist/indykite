{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials Service Account Credentials API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Service Account Credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Service Accounts Credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/service-account-credentials",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Organization ID where to search for Service Accounts credentials."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "List only objects, that contains given search query in name, display name or description"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Service Accounts Credentials in provided Organization with optional filtering."
        },
        {
          "info": {
            "name": "Register Service Account credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/service-account-credentials",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Register Service Account credentials in provided Service Account."
        },
        {
          "info": {
            "name": "Read Service Account Credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/service-account-credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Service Account Credential ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read Service Account Credential identified by provided ID."
        },
        {
          "info": {
            "name": "Delete Service Account Credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/service-account-credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Service Account ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Service Account Credential by provided ID."
        }
      ]
    }
  ],
  "bundled": true
}