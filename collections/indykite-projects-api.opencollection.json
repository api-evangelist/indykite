{
  "opencollection": "1.0.0",
  "info": {
    "name": "Config REST Application Agent Credentials Projects API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/projects",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Project ID where to search for Projects."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "List only objects, that contains given search query in name, display name or description"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Projects in provided Organization with optional filtering."
        },
        {
          "info": {
            "name": "Create Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.api.indykite.com/configs/v1/projects",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Project, formerly known as Application space, in provided Organization."
        },
        {
          "info": {
            "name": "Read Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.api.indykite.com/configs/v1/projects/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Version of configuration to read. If not provided, latest version is returned."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read Project, formerly known as Application space, identified by provided ID."
        },
        {
          "info": {
            "name": "Update Project",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://eu.api.indykite.com/configs/v1/projects/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Project ID or name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update Project, formerly known as Application space, identified by provided ID and optionally etag in If-Match header."
        },
        {
          "info": {
            "name": "Delete Project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.api.indykite.com/configs/v1/projects/:id",
            "headers": [
              {
                "name": "If-Match",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete Project, formerly known as Application space, by provided ID. You can optionally can specify etag in If-Match header."
        }
      ]
    }
  ],
  "bundled": true
}